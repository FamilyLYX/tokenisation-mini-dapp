# Database Configuration
# Choose one option below:

# Database Switch (true = Supabase, false = PostgreSQL)
NEXT_PUBLIC_USE_SUPABASE=true

# Option 1: Supabase (Current - bypasses network restrictions)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Option 2: PostgreSQL (Future - when network allows)
# DATABASE_URL="postgresql://username:password@host:port/database_name?sslmode=require"

#For AWS
ACCESS_KEY_ID=your_access_key
SECRET_ACCESS_KEY=your_secret_key
REGION=your_region
S3_BUCKET=your_bucket_name
NEXT_PUBLIC_API_SECRET_KEY=your_generated_api_key_here